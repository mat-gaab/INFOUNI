<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/branco"
    android:padding="16dp">

    <!-- Cabeçalho com Logo -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/logo_app"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INFOUNI"
            android:textColor="@color/ciano_primario"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Barra de Pesquisa -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/editBusca"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_pesquisa_local"
            android:inputType="text"
            android:importantForAutofill="no"
            android:backgroundTint="@color/ciano_primario"/>

        <Button
            android:id="@+id/btnBuscar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_buscar"
            android:backgroundTint="@color/ciano_primario"
            android:textColor="@color/branco"
            android:layout_marginStart="8dp"/>

        <!-- Botão para Filtrar Favoritos -->
        <ImageButton
            android:id="@+id/btnFiltrarFavoritos"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_favorite_border"
            android:backgroundTint="@color/branco"
            android:layout_marginStart="8dp"
            android:contentDescription="Ver Favoritos" />
    </LinearLayout>

    <!-- Lista de Universidades (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvUniversidades"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/cinza_fundo"
        android:padding="4dp"/>

    <!-- Botões de Navegação  -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnPesquisaWeb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_pesquisa_web"
            android:backgroundTint="@color/ciano_primario"
            android:textColor="@color/branco"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnSair"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_sair"
            android:backgroundTint="#FF5252"
            android:textColor="@color/branco"/>
    </LinearLayout>

</LinearLayout>
